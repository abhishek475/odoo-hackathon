NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
# Use your Supabase Connect panel's direct or SESSION-pooler connection.
# URL-encode password characters. Keep these credentials server-side.
DATABASE_URL=postgresql://postgres:CHANGE_ME@YOUR_HOST:5432/postgres?sslmode=verify-full
# Direct/session connection for migrations; defaults to DATABASE_URL.
DIRECT_URL=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_LEGACY_ANON_KEY
SUPABASE_SECRET_KEY=YOUR_SECRET_OR_LEGACY_SERVICE_ROLE_KEY
# Add this exact URL to the Supabase Auth redirect allowlist.
AUTH_REDIRECT_URL=http://localhost:5173/reset-password
# Optional; set only when running behind a known reverse proxy.
TRUST_PROXY_HOPS=0
# Optional. Without SMTP, invoice sending returns EMAIL_NOT_CONFIGURED.
# Configure Supabase Auth SMTP separately in its dashboard.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
