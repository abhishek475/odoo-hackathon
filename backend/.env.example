# Brightloop Backend Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Supabase PostgreSQL Configuration
# If left blank, the server automatically engages local in-memory fallback mode (DB_FALLBACK_MODE=true)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# JSON Web Token Secret
JWT_SECRET=brightloop_jwt_secret_dev_2026_super_secure
